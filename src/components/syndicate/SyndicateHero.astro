---
import Button from '~/components/ui/Button.astro';
import type { CallToAction } from '~/types';

interface Props {
  tagline?: string;
  title: string;
  highlight?: string;
  subtitle?: string;
  actions?: CallToAction[];
  compact?: boolean;
}

const { tagline, title, highlight, subtitle, actions = [], compact = false } = Astro.props;
---

<section class:list={['syndicate-hero relative not-prose', compact ? 'py-10 md:py-14' : 'py-16 md:py-24 md:-mt-[76px] md:pt-32']}>
  <div class="syndicate-orb syndicate-orb--red -top-24 -left-16" aria-hidden="true"></div>
  <div class="syndicate-orb syndicate-orb--gold top-10 -right-20" aria-hidden="true"></div>
  <div class="syndicate-orb syndicate-orb--white bottom-0 left-1/3" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto max-w-4xl text-center">
      {
        tagline && (
          <p class="syndicate-kicker syndicate-reveal mb-5" data-syndicate-reveal>
            {tagline}
          </p>
        )
      }

      <h1 class="syndicate-title syndicate-reveal syndicate-reveal-delay-1 mb-5 font-heading" data-syndicate-reveal>
        {
          highlight ? (
            <>
              <span class="syndicate-shimmer">{highlight}</span>
              <span class="block text-neutral-200">{title}</span>
            </>
          ) : (
            <span class="syndicate-shimmer">{title}</span>
          )
        }
      </h1>

      {
        subtitle && (
          <p class="syndicate-subtitle syndicate-reveal syndicate-reveal-delay-2 mx-auto mb-8" data-syndicate-reveal>
            {subtitle}
          </p>
        )
      }

      {
        actions.length > 0 && (
          <div class="syndicate-reveal syndicate-reveal-delay-3 flex flex-col items-center justify-center gap-4 sm:flex-row" data-syndicate-reveal>
            {
              actions.map((action) => (
                <Button {...action} class="syndicate-btn-glow w-full sm:w-auto" />
              ))
            }
          </div>
        )
      }
    </div>
  </div>

  {!compact && <div class="syndicate-divider mx-auto mt-14 max-w-3xl syndicate-reveal syndicate-reveal-delay-4" data-syndicate-reveal></div>}
</section>
